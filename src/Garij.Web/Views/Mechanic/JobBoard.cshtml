@model IEnumerable<Garij.Application.DTOs.ServiceJobDto>
@using Garij.Domain.Enums
@using Garij.Web.Helpers

@{
    ViewData["Title"] = "Mechanic Job Board";
    int? selectedMechanicId = ViewBag.SelectedMechanicId as int?;
    var mechanics = ViewBag.Mechanics as SelectList;
    var currentStaffUser = ViewBag.CurrentStaffUser as Garij.Domain.Entities.User;
}

<!-- Header & Filter Section -->
<div class="app-card mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-kanban fs-2 text-info"></i>
                <h1 class="app-page-title mb-0">Mechanic Job Board</h1>
            </div>
            <p class="app-page-subtitle mt-1">Touch-friendly workflow dashboard for active vehicle repairs &amp; diagnostic tasks.</p>
        </div>

        <form method="get" asp-controller="Mechanic" asp-action="JobBoard" class="d-flex align-items-center gap-2 w-100 w-md-auto">
            <label for="mechanicId" class="app-form-label mb-0 text-nowrap">Filter Mechanic:</label>
            <select name="mechanicId" id="mechanicId" class="app-form-select" onchange="this.form.submit()">
                <option value="">-- All Assigned Jobs --</option>
                @if (mechanics != null)
                {
                    foreach (var item in mechanics)
                    {
                        if (selectedMechanicId?.ToString() == item.Value)
                        {
                            <option value="@item.Value" selected="selected">@item.Text</option>
                        }
                        else
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                }
            </select>
        </form>
    </div>
</div>

<!-- Alert Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="app-alert-success">
        <span><i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]</span>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="app-alert-danger">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
    </div>
}

<!-- Job Cards Grid -->
@if (!Model.Any())
{
    <div class="app-card">
        <div class="app-empty-state">
            <i class="bi bi-clipboard-check"></i>
            <h4 class="text-white fw-semibold">No assigned jobs found</h4>
            <p class="app-page-subtitle mb-0">Select another mechanic from the filter or check back later for new assignments.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3 g-md-4">
        @foreach (var job in Model)
        {
            var isCompleted = job.Status == JobStatus.Completed;
            var isCancelled = job.Status == JobStatus.Cancelled;

            JobStatus? nextStatus = job.Status switch
            {
                JobStatus.Requested => JobStatus.InspectionPending,
                JobStatus.InspectionPending => JobStatus.CustomerApprovalNeeded,
                JobStatus.CustomerApprovalNeeded => JobStatus.InProgress,
                JobStatus.InProgress => JobStatus.Completed,
                _ => null
            };

            string nextStatusLabel = nextStatus switch
            {
                JobStatus.InspectionPending => "Start Inspection",
                JobStatus.CustomerApprovalNeeded => "Request Customer Approval",
                JobStatus.InProgress => "Begin Work (In Progress)",
                JobStatus.Completed => "Mark Job Completed",
                _ => ""
            };

            <div class="col-12 col-md-6 col-xl-4">
                <div class="app-card h-100 d-flex flex-column @(isCompleted ? "opacity-75" : "")">
                    <!-- Card Header -->
                    <div class="d-flex justify-content-between align-items-center pb-3 mb-3" style="border-bottom: 1px solid var(--border-dark);">
                        <div>
                            <span class="fw-bold text-white">@job.BookingReference</span>
                            <span class="app-badge @StatusBadgeHelper.BadgeClass(job.Status) ms-2">@job.Status</span>
                        </div>
                        <span class="app-page-subtitle small"><i class="bi bi-clock me-1"></i>@job.CreatedAt.ToString("MMM dd, HH:mm")</span>
                    </div>

                    <!-- Vehicle Details -->
                    <div class="d-flex align-items-center mb-3 p-2 rounded-3" style="background: rgba(255,255,255,0.04);">
                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width:44px;height:44px;background:var(--accent-blue-btn);box-shadow:0 0 12px rgba(0,114,245,0.5);">
                            <i class="bi bi-car-front-fill text-white fs-5"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold text-white">@job.VehiclePlateNumber</h6>
                            <small class="app-page-subtitle">@job.VehicleDescription &bull; Owner: @job.CustomerName</small>
                        </div>
                    </div>

                    <!-- Job Type & Mechanics Assigned -->
                    <div class="mb-3">
                        <div class="small fw-semibold app-page-subtitle mb-1">Job Type: <span class="text-white">@job.JobType</span></div>
                        <div class="small fw-semibold app-page-subtitle mb-1">Assigned Team:</div>
                        <div class="d-flex flex-wrap">
                            @if (job.MechanicAssignments.Any())
                            {
                                foreach (var ma in job.MechanicAssignments)
                                {
                                    <span class="app-chip"><i class="bi bi-person-badge"></i>@ma.MechanicName (@ma.RoleInJob)</span>
                                }
                            }
                            else
                            {
                                <span class="app-chip">No mechanics assigned yet</span>
                            }
                        </div>
                    </div>

                    <!-- Diagnostic Notes -->
                    <div class="mb-3">
                        <label class="small fw-semibold app-page-subtitle mb-1 d-block"><i class="bi bi-journal-text me-1"></i>Diagnostic Notes</label>
                        <div class="p-2 rounded-3 small text-break" style="background: rgba(255,255,255,0.04); border: 1px solid var(--border-dark); color: var(--text-light);">
                            @(string.IsNullOrWhiteSpace(job.DiagnosticNotes) ? "No diagnostic notes recorded yet." : job.DiagnosticNotes)
                        </div>
                        @if (!isCompleted && !isCancelled)
                        {
                            <button class="btn btn-sm btn-link p-0 text-decoration-none mt-2 text-info fw-semibold" data-bs-toggle="collapse" data-bs-target="#editNotes-@job.Id">
                                <i class="bi bi-pencil-square me-1"></i>Edit Notes
                            </button>
                            <div class="collapse mt-2" id="editNotes-@job.Id">
                                <form method="post" asp-controller="Mechanic" asp-action="SaveNotes">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="serviceJobId" value="@job.Id" />
                                    <input type="hidden" name="mechanicId" value="@selectedMechanicId" />
                                    <textarea name="diagnosticNotes" class="app-form-control mb-2" rows="3" placeholder="Add diagnostic notes...">@job.DiagnosticNotes</textarea>
                                    <button type="submit" class="app-btn app-btn-primary app-btn-sm w-100">Save Diagnostic Notes</button>
                                </form>
                            </div>
                        }
                    </div>

                    <!-- Touch-Friendly Card Actions Footer -->
                    <div class="mt-auto pt-3" style="border-top: 1px solid var(--border-dark);">
                        <div class="d-flex flex-column gap-2">
                            @if (!isCompleted && !isCancelled && nextStatus.HasValue)
                            {
                                <form method="post" asp-controller="Mechanic" asp-action="UpdateStatus" class="w-100">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="serviceJobId" value="@job.Id" />
                                    <input type="hidden" name="newStatus" value="@nextStatus.Value" />
                                    <input type="hidden" name="mechanicId" value="@selectedMechanicId" />
                                    <button type="submit" class="app-btn app-btn-primary w-100 py-3"
                                            title="@(nextStatus == JobStatus.Completed ? "Ensure parts used are logged before marking completed" : "")">
                                        <i class="bi bi-arrow-right-circle-fill"></i>
                                        <span>@nextStatusLabel</span>
                                    </button>
                                </form>
                            }

                            <div class="d-flex gap-2">
                                <a asp-controller="ServiceJob" asp-action="Details" asp-route-id="@job.Id" class="app-btn app-btn-outline flex-fill">
                                    <i class="bi bi-info-circle"></i> Job Details
                                </a>
                                <a asp-controller="Parts" asp-action="LogUsage" asp-route-serviceJobId="@job.Id" class="app-btn app-btn-outline flex-fill">
                                    <i class="bi bi-box-seam"></i> Log Parts
                                </a>
                                @if (!isCompleted && !isCancelled)
                                {
                                    <form method="post" asp-controller="Mechanic" asp-action="UpdateStatus" onsubmit="return confirm('Are you sure you want to cancel this job?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="serviceJobId" value="@job.Id" />
                                        <input type="hidden" name="newStatus" value="@JobStatus.Cancelled" />
                                        <input type="hidden" name="mechanicId" value="@selectedMechanicId" />
                                        <button type="submit" class="app-btn app-btn-danger" title="Cancel Job">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
