@model IEnumerable<InvoiceDto>
@using Garij.Domain.Enums

@{
    ViewData["Title"] = "Invoices";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0"><i class="bi bi-receipt me-2"></i>Invoices</h1>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light py-3">
            <h5 class="card-title mb-0">Generate Invoice for a Service Job</h5>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="get" class="row g-2 align-items-end">
                <div class="col-auto">
                    <label for="serviceJobId" class="form-label fw-bold mb-1">Service Job ID</label>
                    <input type="number" min="1" name="serviceJobId" id="serviceJobId" class="form-control" placeholder="e.g. 1" required />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-arrow-right-circle me-1"></i> Generate Invoice</button>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted text-center py-4">No invoices generated yet.</p>
    }
    else
    {
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Invoice #</th>
                    <th>Issued</th>
                    <th class="text-end">Subtotal</th>
                    <th class="text-end">Tax</th>
                    <th class="text-end">Total</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var invoice in Model)
                {
                    var statusBadge = invoice.PaymentStatus switch
                    {
                        PaymentStatus.Pending => "bg-warning text-dark",
                        PaymentStatus.PartiallyPaid => "bg-info text-dark",
                        PaymentStatus.Paid => "bg-success text-white",
                        PaymentStatus.Refunded => "bg-secondary text-white",
                        _ => "bg-secondary text-white"
                    };
                    <tr>
                        <td class="font-monospace">@invoice.InvoiceNumber</td>
                        <td>@invoice.IssuedAt.ToString("MMM dd, yyyy")</td>
                        <td class="text-end">@invoice.SubTotal.ToString("C")</td>
                        <td class="text-end">@invoice.TaxAmount.ToString("C")</td>
                        <td class="text-end fw-bold">@invoice.TotalAmount.ToString("C")</td>
                        <td><span class="badge @statusBadge">@invoice.PaymentStatus</span></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@invoice.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
