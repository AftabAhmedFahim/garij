@model InvoiceDto
@using Garij.Domain.Enums

@{
    ViewData["Title"] = $"Invoice {Model.InvoiceNumber}";
    var statusBadge = Model.PaymentStatus switch
    {
        PaymentStatus.Pending => "bg-warning text-dark",
        PaymentStatus.PartiallyPaid => "bg-info text-dark",
        PaymentStatus.Paid => "bg-success text-white",
        PaymentStatus.Refunded => "bg-secondary text-white",
        _ => "bg-secondary text-white"
    };
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Invoice <span class="font-monospace text-primary">@Model.InvoiceNumber</span></h1>
            <span class="badge @statusBadge px-3 py-2 fs-6">@Model.PaymentStatus</span>
        </div>
        <div class="btn-group">
            @if (Model.OutstandingBalance > 0)
            {
                <a asp-action="RecordPayment" asp-route-invoiceId="@Model.Id" class="btn btn-success">
                    <i class="bi bi-cash-coin me-1"></i> Record Payment
                </a>
            }
            <a asp-action="Index" class="btn btn-outline-dark">Back to List</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light py-3">
                    <h5 class="card-title mb-0"><i class="bi bi-card-checklist me-2"></i>Job &amp; Customer</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Booking Reference:</dt>
                        <dd class="col-sm-8 font-monospace">@Model.BookingReference</dd>

                        <dt class="col-sm-4 text-muted">Customer:</dt>
                        <dd class="col-sm-8">@Model.CustomerName</dd>

                        <dt class="col-sm-4 text-muted">Vehicle:</dt>
                        <dd class="col-sm-8">@Model.VehicleDescription</dd>

                        <dt class="col-sm-4 text-muted">Issued:</dt>
                        <dd class="col-sm-8">@Model.IssuedAt.ToString("f")</dd>
                    </dl>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light py-3">
                    <h5 class="card-title mb-0"><i class="bi bi-tools me-2"></i>Services</h5>
                </div>
                <div class="card-body p-0">
                    @if (!Model.ServiceLines.Any())
                    {
                        <p class="text-muted text-center py-3 mb-0">No services logged.</p>
                    }
                    else
                    {
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Line Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in Model.ServiceLines)
                                {
                                    <tr>
                                        <td>@line.Description</td>
                                        <td class="text-end">@line.Quantity</td>
                                        <td class="text-end">@line.UnitPrice.ToString("C")</td>
                                        <td class="text-end">@line.LineTotal.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light py-3">
                    <h5 class="card-title mb-0"><i class="bi bi-gear me-2"></i>Parts</h5>
                </div>
                <div class="card-body p-0">
                    @if (!Model.PartLines.Any())
                    {
                        <p class="text-muted text-center py-3 mb-0">No parts logged.</p>
                    }
                    else
                    {
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Line Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in Model.PartLines)
                                {
                                    <tr>
                                        <td>@line.Description</td>
                                        <td class="text-end">@line.Quantity</td>
                                        <td class="text-end">@line.UnitPrice.ToString("C")</td>
                                        <td class="text-end">@line.LineTotal.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-3">
                    <h5 class="card-title mb-0"><i class="bi bi-clock-history me-2"></i>Payment History</h5>
                </div>
                <div class="card-body p-0">
                    @if (!Model.Payments.Any())
                    {
                        <p class="text-muted text-center py-3 mb-0">No payments recorded yet.</p>
                    }
                    else
                    {
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Method</th>
                                    <th>Reference</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in Model.Payments)
                                {
                                    <tr>
                                        <td>@payment.PaidAt.ToString("MMM dd, yyyy HH:mm")</td>
                                        <td><span class="badge bg-light text-dark border">@payment.PaymentMethod</span></td>
                                        <td class="font-monospace small">@payment.TransactionReference</td>
                                        <td class="text-end">@payment.Amount.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-3">
                    <h5 class="card-title mb-0"><i class="bi bi-calculator me-2"></i>Summary</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-7 text-muted">Subtotal:</dt>
                        <dd class="col-5 text-end">@Model.SubTotal.ToString("C")</dd>

                        <dt class="col-7 text-muted">Tax:</dt>
                        <dd class="col-5 text-end">@Model.TaxAmount.ToString("C")</dd>

                        <dt class="col-7 fw-bold">Total:</dt>
                        <dd class="col-5 text-end fw-bold">@Model.TotalAmount.ToString("C")</dd>

                        <dt class="col-7 text-muted">Paid:</dt>
                        <dd class="col-5 text-end text-success">@Model.AmountPaid.ToString("C")</dd>

                        <dt class="col-7 fw-bold">Outstanding:</dt>
                        <dd class="col-5 text-end fw-bold @(Model.OutstandingBalance > 0 ? "text-danger" : "text-success")">
                            @Model.OutstandingBalance.ToString("C")
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>
