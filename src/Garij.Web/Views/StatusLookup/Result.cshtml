@model StatusLookupViewModel
@using Garij.Domain.Enums
@{
    ViewData["Title"] = "Service Status";
    var currentJob = Model.CurrentJob;
    var vehicle = Model.Vehicle;
    var statusOrder = StatusLookupViewModel.TimelineStatuses;
    var currentIndex = currentJob is null ? -1 : statusOrder.ToList().IndexOf(currentJob.Status);
    var isCancelled = currentJob?.Status == JobStatus.Cancelled;

    string BadgeClass(JobStatus status) => status switch
    {
        JobStatus.Requested => "bg-warning text-dark",
        JobStatus.InspectionPending => "bg-info text-dark",
        JobStatus.CustomerApprovalNeeded => "bg-secondary text-white",
        JobStatus.InProgress => "bg-primary text-white",
        JobStatus.Completed => "bg-success text-white",
        JobStatus.Cancelled => "bg-danger text-white",
        _ => "bg-secondary text-white"
    };
}

<section class="status-result-shell">
    <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 mb-3">
        <div>
            <p class="lookup-kicker mb-1">Public status lookup</p>
            <h1 class="h3 mb-0">Service Status</h1>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary align-self-sm-start">
            <i class="bi bi-arrow-left me-1"></i> New Search
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-warning lookup-alert">
            <div class="fw-semibold">No result found</div>
            <div>@Model.Message</div>
        </div>
    }
    else if (vehicle is not null)
    {
        <div class="vehicle-summary">
            <div>
                <span class="text-muted small">Vehicle</span>
                <h2>@vehicle.LicensePlateNumber</h2>
                <p>@vehicle.Year @vehicle.Make @vehicle.Model</p>
            </div>
            @if (currentJob is not null)
            {
                <span class="badge @BadgeClass(currentJob.Status) status-pill">@currentJob.Status</span>
            }
        </div>

        @if (currentJob is not null)
        {
            <div class="current-job-panel">
                <div class="job-meta-grid">
                    <div>
                        <span>Booking</span>
                        <strong class="font-monospace">@currentJob.BookingReference</strong>
                    </div>
                    <div>
                        <span>Job type</span>
                        <strong>@currentJob.JobType</strong>
                    </div>
                    <div>
                        <span>Received</span>
                        <strong>@currentJob.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</strong>
                    </div>
                    <div>
                        <span>Completed</span>
                        <strong>@(currentJob.CompletedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "Pending")</strong>
                    </div>
                </div>

                <h3 class="h5 mt-4 mb-3">Status Timeline</h3>
                <ol class="status-timeline">
                    @for (var i = 0; i < statusOrder.Count; i++)
                    {
                        var status = statusOrder[i];
                        var stepClass = isCancelled
                            ? "timeline-muted"
                            : i < currentIndex ? "timeline-complete"
                            : i == currentIndex ? "timeline-current"
                            : "timeline-upcoming";

                        <li class="@stepClass">
                            <span class="timeline-dot"></span>
                            <div>
                                <strong>@status</strong>
                                <small>
                                    @(i < currentIndex ? "Done" : i == currentIndex ? "Current step" : "Upcoming")
                                </small>
                            </div>
                        </li>
                    }
                    @if (isCancelled)
                    {
                        <li class="timeline-cancelled">
                            <span class="timeline-dot"></span>
                            <div>
                                <strong>Cancelled</strong>
                                <small>This service job is no longer active.</small>
                            </div>
                        </li>
                    }
                </ol>
            </div>
        }
        else
        {
            <div class="alert alert-info lookup-alert">This vehicle has no service jobs recorded yet.</div>
        }

        <div class="history-section">
            <div class="d-flex justify-content-between align-items-end gap-2 mb-3">
                <div>
                    <p class="lookup-kicker mb-1">Full record</p>
                    <h2 class="h4 mb-0">Service History</h2>
                </div>
                <span class="text-muted small">@Model.ServiceHistory.Count job(s)</span>
            </div>

            @if (!Model.ServiceHistory.Any())
            {
                <div class="alert alert-info lookup-alert">No service history has been recorded for this vehicle yet.</div>
            }
            else
            {
                <div class="history-list">
                    @foreach (var job in Model.ServiceHistory)
                    {
                        <article class="history-item">
                            <div>
                                <strong class="font-monospace">@job.BookingReference</strong>
                                <div class="text-muted small">@job.JobType</div>
                            </div>
                            <div class="history-date">
                                <span class="badge @BadgeClass(job.Status)">@job.Status</span>
                                <small>@job.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    }
</section>

<section class="public-lookup-shell pt-0">
    <div class="public-lookup-panel compact">
        <form asp-action="Result" method="get" class="lookup-form">
            <label for="query" class="form-label">Search another booking or plate</label>
            <div class="lookup-input-row">
                <input id="query"
                       name="query"
                       value="@Model.Query"
                       class="form-control"
                       required
                       placeholder="GRJ-2026-0001 or DHA-2026" />
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search me-1"></i> Search
                </button>
            </div>
        </form>
    </div>
</section>
