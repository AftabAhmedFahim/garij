@model StatusLookupViewModel
@{
    ViewData["Title"] = "Service Status Lookup";
}

<section class="public-lookup-shell">
    <div class="public-lookup-panel">
        <div class="lookup-heading">
            <p class="lookup-kicker">Garij public portal</p>
            <h1>Track your vehicle service</h1>
            <p>Enter your booking reference or license plate to see the current job status and service history.</p>
        </div>

        <form asp-action="Result" method="get" class="lookup-form">
            <label for="query" class="form-label">Booking reference or plate number</label>
            <div class="lookup-input-row">
                <input id="query"
                       name="query"
                       value="@Model.Query"
                       class="form-control form-control-lg"
                       required
                       placeholder="GRJ-2026-0001 or DHA-2026" />
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-search me-1"></i> Search
                </button>
            </div>
        </form>
    </div>
</section>
