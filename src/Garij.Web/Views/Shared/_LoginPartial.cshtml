@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <span class="d-none d-lg-inline-flex align-items-center gap-1 text-light small fw-semibold me-1">
        <i class="bi bi-person-circle text-info"></i>@User.Identity?.Name
    </span>
    <a class="btn-nav-glow-register" asp-area="" asp-controller="Account" asp-action="Logout">
        <i class="bi bi-box-arrow-right"></i>
        <span>Logout</span>
    </a>
}
else
{
    <a class="btn-nav-glow-register" asp-area="" asp-controller="Account" asp-action="Register">
        <i class="bi bi-person-plus"></i>
        <span>Register</span>
    </a>
    <a class="btn-nav-glow-login" asp-area="" asp-controller="Account" asp-action="Login">
        <i class="bi bi-box-arrow-in-right"></i>
        <span>Login</span>
    </a>
}
