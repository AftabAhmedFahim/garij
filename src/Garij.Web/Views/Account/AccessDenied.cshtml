@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center mt-5 text-center">
    <div class="col-md-6">
        <div class="card shadow-lg border-0 rounded-4 p-5">
            <div class="mb-3 text-danger">
                <i class="bi bi-shield-exclamation display-1"></i>
            </div>
            <h2 class="fw-bold text-dark mb-2">Access Denied</h2>
            <p class="text-secondary fs-5 mb-4">You do not have permission to access this resource or module.</p>
            <div>
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-lg rounded-3 px-4 me-2">
                    <i class="bi bi-speedometer2 me-2"></i>Go to Dashboard
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-lg rounded-3 px-4">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Switch Account
                </a>
            </div>
        </div>
    </div>
</div>
